{{- /* variables.tf — generated by serverless-to-ecs */ -}}

variable "region" {
  type    = string
  default = "{{ .Region }}"
}

variable "project_name" {
  type    = string
  default = "{{ .ProjectName }}"
}

variable "vpc_id" {
  type        = string
  description = "VPC ID for ECS services and ALB"
}

variable "subnet_ids" {
  type        = list(string)
  description = "Subnet IDs for ECS tasks and ALB (use public subnets if no NAT)"
}

variable "tags" {
  type    = map(string)
  default = {}
}

# ── Container images ────────────────────────────────────────
# Replace these with your actual ECR image URIs after
# containerizing the Lambda function code.
{{ range .Services }}
variable "{{ tfident .Name }}_image" {
  type        = string
  default     = "PLACEHOLDER:latest"
  description = "Container image for {{ .Name }} ({{ .Type }})"
}
{{ end }}
# ── Service scaling ─────────────────────────────────────────
# Set desired_count to 0 to keep a service defined but dormant.
# This is the strangler toggle: bring services up one at a time,
# shift traffic, then decommission the Lambda equivalent.
{{ range .Services }}
variable "{{ tfident .Name }}_desired_count" {
  type    = number
  default = {{ .DesiredCount }}
}
{{ end }}
# ── Secrets (Secrets Manager / SSM Parameter Store) ─────────
# Replace these defaults with the actual ARNs. The source column notes
# where the value came from in the original template.
{{ range .Services }}
{{- $svc := . }}
{{- range .Secrets }}
variable "{{ .VarName }}" {
  type        = string
  description = "{{ $svc.Name }}: {{ .Key }} ({{ .Kind }}, source: {{ .SourceHint }})"
  default     = "TODO_REPLACE_WITH_ARN"
}
{{ end }}
{{- end }}
# ── EFS (existing file systems — not created by this Terraform) ─
{{ range .Services }}
{{- $svc := . }}
{{- range .EFSMounts }}
variable "{{ .FileSystemVar }}" {
  type        = string
  description = "EFS file system ID to mount into {{ $svc.Name }} at {{ .ContainerPath }}"
}
variable "{{ .AccessPointVar }}" {
  type        = string
  description = "EFS access point ID to mount into {{ $svc.Name }} at {{ .ContainerPath }}"
}
{{ end }}
{{- end }}
