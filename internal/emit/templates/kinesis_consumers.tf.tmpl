{{- /* kinesis_consumers.tf — generated by serverless-to-ecs */ -}}
{{ if .KinesisConsumers }}
# ── Kinesis Stream Consumers ────────────────────────────────
# These replace Lambda event source mappings with long-running
# ECS services that consume the stream directly via the AWS SDK
# (e.g. the Kinesis Client Library). Benefits:
#   - No cold starts
#   - Explicit checkpointing and shard-rebalancing control
#   - Standard container health checks
#
# Your containerized code should:
#   1. Use KCL (or a language-appropriate consumer library) to
#      subscribe to the stream and manage shard leases
#   2. Checkpoint after successful processing
#   3. Handle SIGTERM for graceful shutdown (release shard leases)
{{ range .KinesisConsumers }}
# Replaces: {{ join .SourceLambdas ", " }} ← {{ .StreamName }}
{{ if .Resolved }}
# Note: the task definition for this consumer is in ecs.tf
# as part of the "{{ .ServiceName }}" service group.
# The service is already defined there. This file documents
# the stream-specific configuration.
{{ else }}
# TODO: could not determine which ECS service group consumes this stream.
# Check ecs.tf manually for the service handling the source Lambda(s) above.
{{ end }}
#
# Required environment variables for the container:
#   KINESIS_STREAM_NAME = {{ .StreamName }}
#   KINESIS_APPLICATION_NAME = <KCL application name, e.g. "{{ .ServiceName }}">
{{ end }}
{{ end }}
