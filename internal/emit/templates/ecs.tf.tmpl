{{- /* ecs.tf — generated by serverless-to-ecs */ -}}

resource "aws_ecs_cluster" "main" {
  name = "${local.project}-cluster"

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = local.tags
}

resource "aws_cloudwatch_log_group" "ecs" {
  name              = "/ecs/${local.project}"
  retention_in_days = 14
  tags              = local.tags
}
{{ range .Services }}
# ── {{ .Name }} ({{ .Type }}) ──
# Source Lambdas: {{ join .LambdaIDs ", " }}
# Reason: {{ .Reason }}

resource "aws_ecs_task_definition" "{{ tfident .Name }}" {
  family                   = "{{ .Name }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = {{ .CPU }}
  memory                   = {{ .Memory }}
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.ecs_task.arn
{{- range .EFSMounts }}

  volume {
    name = "{{ .VolumeName }}"
    efs_volume_configuration {
      file_system_id     = var.{{ .FileSystemVar }}
      transit_encryption = "ENABLED"
      authorization_config {
        access_point_id = var.{{ .AccessPointVar }}
        iam             = "ENABLED"
      }
    }
  }
{{- end }}

  container_definitions = jsonencode([{
    name  = "{{ .Name }}"
    image = var.{{ tfident .Name }}_image

    portMappings = [{
      containerPort = 8080
      protocol      = "tcp"
    }]

    environment = [
{{- range .EnvVars }}
      { name = {{ .KeyQuoted }}, value = {{ .ValueQuoted }} },
{{- end }}
    ]
    secrets = [
{{- range .Secrets }}
      { name = {{ .KeyQuoted }}, valueFrom = var.{{ .VarName }} },
{{- end }}
    ]
    mountPoints = [
{{- range .EFSMounts }}
      { sourceVolume = "{{ .VolumeName }}", containerPath = "{{ .ContainerPath }}" },
{{- end }}
    ]

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = aws_cloudwatch_log_group.ecs.name
        "awslogs-region"        = var.region
        "awslogs-stream-prefix" = "{{ .Name }}"
      }
    }
  }])

  tags = local.tags
}
{{ if ne .Type "scheduled" }}
resource "aws_ecs_service" "{{ tfident .Name }}" {
  name            = "{{ .Name }}"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.{{ tfident .Name }}.arn
  desired_count   = var.{{ tfident .Name }}_desired_count
  launch_type     = "FARGATE"
{{- if .EFSMounts }}

  # EFS volumes require platform version 1.4.0 or later.
  platform_version = "1.4.0"
{{- end }}
{{- if .VPCNote }}

  # Source Lambda(s) ran inside a VPC — verify the subnets/security groups
  # below provide equivalent network connectivity (e.g. reaching an RDS
  # instance or another internal service). Original Lambda VPC config:
  # {{ .VPCNote }}
{{- end }}

  network_configuration {
    subnets         = var.subnet_ids
    security_groups = [aws_security_group.ecs.id]
  }
{{ if eq .Type "api" }}
  load_balancer {
    target_group_arn = aws_lb_target_group.{{ tfident .Name }}.arn
    container_name   = "{{ .Name }}"
    container_port   = 8080
  }

  depends_on = [aws_lb_listener_rule.{{ tfident .Name }}]
{{ end }}
  tags = local.tags
}
{{ end }}
{{ end }}
