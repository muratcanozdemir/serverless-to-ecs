{{- /* sqs_pollers.tf — generated by serverless-to-ecs */ -}}
{{ if .QueuePollers }}
# ── SQS Poller Services ────────────────────────────────────
# These replace Lambda event source mappings with long-running
# ECS services that poll SQS directly. Benefits:
#   - No cold starts
#   - Controlled concurrency
#   - Graceful shutdown via SIGTERM
#   - Standard container health checks
#
# Your containerized code should:
#   1. Long-poll SQS (WaitTimeSeconds=20)
#   2. Process messages in batches
#   3. Delete messages on success
#   4. Let visibility timeout expire on failure (automatic retry)
#   5. Handle SIGTERM for graceful drain
{{ range .QueuePollers }}
# Replaces: {{ join .SourceLambdas ", " }} ← {{ .QueueName }}

# Note: the task definition for this poller is in ecs.tf
# as part of the "{{ .ServiceName }}" service group.
# The service is already defined there. This file documents
# the queue-specific configuration.
#
# Required environment variables for the container:
#   SQS_QUEUE_URL = aws_sqs_queue reference or SSM parameter
#   SQS_BATCH_SIZE = 10
#   SQS_WAIT_TIME = 20
{{ end }}
{{ end }}
