{{- /* s3_event_processors.tf — generated by serverless-to-ecs */ -}}
{{ if .S3EventProcessors }}
# ── S3 Event Processors ─────────────────────────────────────
# S3 can't invoke a long-running ECS container directly the way
# it invokes Lambda — there's no ECS RunTask notification target.
# To migrate these triggers, reconfigure the bucket to publish to
# one of:
#   1. EventBridge (NotificationConfiguration.EventBridgeConfiguration),
#      then an EventBridge rule → ECS RunTask (same pattern as
#      scheduled.tf), matching on the s3:ObjectCreated/Removed event.
#   2. An SQS queue, then treat it like any other queue-processor
#      (see sqs_pollers.tf) — the container polls the queue instead
#      of receiving push notifications.
#
# Neither reconfiguration is generated automatically: it changes the
# bucket's NotificationConfiguration, which is a change to existing,
# retained infrastructure rather than something this tool creates.
{{ range .S3EventProcessors }}
# Replaces: {{ join .SourceLambdas ", " }} ← {{ .BucketName }}
{{ if .Resolved }}
# Note: the task definition for this processor is in ecs.tf
# as part of the "{{ .ServiceName }}" service group.
# The service is already defined there. This file documents
# the bucket-specific migration step above.
{{ else }}
# TODO: could not determine which ECS service group processes events
# from this bucket. Check ecs.tf manually for the service handling
# the source Lambda(s) above.
{{ end }}
{{ end }}
{{ end }}
