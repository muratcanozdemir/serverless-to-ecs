{{- /* scheduled.tf — generated by serverless-to-ecs */ -}}
{{ if .Schedules }}
# ── ECS Scheduled Tasks ────────────────────────────────────
# These replace EventBridge scheduled rules → Lambda with
# EventBridge → ECS RunTask. Same scheduling, containerized execution.
{{ range .Schedules }}
resource "aws_cloudwatch_event_rule" "{{ tfident .Name }}" {
  name                = "${local.project}-{{ .Name }}"
  schedule_expression = "{{ .Schedule }}"
  description         = "Migrated from Lambda: {{ join .SourceLambdas ", " }}"
  tags                = local.tags
}

{{ if .Resolved }}
resource "aws_cloudwatch_event_target" "{{ tfident .Name }}" {
  rule     = aws_cloudwatch_event_rule.{{ tfident .Name }}.name
  arn      = aws_ecs_cluster.main.arn
  role_arn = aws_iam_role.ecs_events.arn

  ecs_target {
    task_count          = 1
    task_definition_arn = aws_ecs_task_definition.{{ tfident .TaskDefRef }}.arn
    launch_type         = "FARGATE"

    network_configuration {
      subnets         = var.subnet_ids
      security_groups = [aws_security_group.ecs.id]
    }
  }
}
{{ else }}
# TODO: could not determine which ECS task definition should run on this
# schedule (no source Lambda resolved to a generated service group). Add an
# aws_cloudwatch_event_target manually once the target service is known.
{{ end }}
{{ end }}
{{ end }}
